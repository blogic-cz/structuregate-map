#!/bin/sh
# NOTHING PRIVATE IS COMMITTED TO THIS PUBLIC REPOSITORY. Two checks of what is STAGED, before the commit exists:
#
#  1. the deny list (the gitignored `leak-deny.txt`, the terms LeakGuard fails the BUILD on) against every staged
#     file - exact, instant, and it blocks: a commit made without a build would otherwise carry a term past LeakGuard;
#  2. an agent (`claude -p`, the instructions in `.githooks/leak-review.md`) reading the staged diff for what no list
#     can name yet: a new consumer name, a private path, a domain word, a figure measured on a private tree.
#
# Turned on per clone: `git config core.hooksPath .githooks`. `SG_LEAK_REVIEW=0 git commit ...` skips the agent
# (never the deny list); `git commit --no-verify` skips both. No `claude` on PATH, or an agent that gives no verdict,
# is a WARNING and the commit goes on - the deny list still decided.

root=$(git rev-parse --show-toplevel) || exit 1
deny="$root/leak-deny.txt"

# 1. THE DENY LIST, over the index (what will be committed), the vendored upstream source excepted as LeakGuard does.
if [ -s "$deny" ]; then
    hits=$(git -C "$root" grep --cached -n -I -F -f "$deny" -- . ':(exclude)rust/fbtcore/vendor')
    if [ -n "$hits" ]; then
        echo "pre-commit: a term of leak-deny.txt is staged - the repository is public:" >&2
        echo "$hits" >&2
        exit 1
    fi
else
    echo "pre-commit: no leak-deny.txt at the root - the deny list was not checked" >&2
fi

# 2. THE AGENT, over the staged diff.
[ "$SG_LEAK_REVIEW" = "0" ] && exit 0
if ! command -v claude >/dev/null 2>&1; then
    echo "pre-commit: WARNING - no claude on PATH, the leak review did not run (the deny list did)" >&2
    exit 0
fi
diff=$(git -C "$root" diff --cached --no-color --unified=1 -- . ':(exclude)rust/fbtcore/vendor' ':(exclude)rust/fbtcore/Cargo.lock')
[ -z "$diff" ] && exit 0
prompt=$(cat "$root/.githooks/leak-review.md")
if [ -s "$deny" ]; then
    prompt="$prompt

DENY LIST (one term per line, private - never repeat it outside a finding):
$(cat "$deny")"
fi
echo "pre-commit: leak review of the staged diff (SG_LEAK_REVIEW=0 skips it) ..." >&2
answer=$(printf '%s\n' "$diff" | timeout 900 claude -p "$prompt" --no-session-persistence --disallowedTools "Bash Edit Write NotebookEdit WebFetch WebSearch" 2>/dev/null)
verdict=$(printf '%s\n' "$answer" | grep -F 'LEAK-REVIEW:' | tail -n 1)
case "$verdict" in
    *"LEAK-REVIEW: PASS"*)
        echo "pre-commit: leak review passed" >&2
        exit 0 ;;
    *"LEAK-REVIEW: FAIL"*)
        echo "pre-commit: the leak review found what may be private - fix it, or commit with --no-verify if it is not:" >&2
        printf '%s\n' "$answer" | grep -v -F 'LEAK-REVIEW:' >&2
        exit 1 ;;
    *)
        echo "pre-commit: WARNING - the leak review gave no verdict (the deny list passed):" >&2
        printf '%s\n' "$answer" | tail -n 5 >&2
        exit 0 ;;
esac
